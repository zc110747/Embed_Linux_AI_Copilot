################################################################################
# This file is used to define global alias, if want to create the build system, 
# also need update the file.
#
################################################################################
# build qemu support kernel
function build_kernel()
{
    cd ${AGENT_PLATFORM_SOC_PATH}/linux-imx-lf-6.1.y-patch || return

    ./kernel_upgrade.sh

    cd ${AGENT_PLATFORM_SOC_PATH}/platform-shell || return

    ./make.sh kernel $1
}
alias AgentKernel="build_kernel"

# build qemu and run
function build_qemu()
{
    cd ${AGENT_PLATFORM_SOC_PATH}/platform-shell || return

    ./build-qemu.sh $1
}
alias AgentQemu="build_qemu"

# build qemu and run
function build_rootfs()
{
    cd "${AGENT_PLATFORM_SOC_PATH}"/platform-shell || return

    cp -rv ${AGENT_PLATFORM_SOC_PATH}/buildroot-patch/imx6ullrmk_defconfig ${AGENT_SDK_SOC_PATH}/rootfs/buildroot/configs/

    ./make.sh rootfs $1
}
alias AgentRootfs="build_rootfs"

function mount_rootfs()
{
    sudo umount -l ${AGENT_SDK_NFS_PATH}
    
    sdk_img="${AGENT_SDK_SOC_PATH}"/package/${AGENT_IMG}

    if [ ! -f "$sdk_img" ]; then
        echo "no exist:${sdk_img}" 
        return
    fi

    sudo mount -o loop ${sdk_img} ${AGENT_SDK_NFS_PATH}

    sudo mount -t proc chproc "${AGENT_SDK_NFS_PATH}"/proc
    sudo mount -t sysfs chsys "${AGENT_SDK_NFS_PATH}"/sys
    sudo mount -t devtmpfs chdev "${AGENT_SDK_NFS_PATH}"/dev || sudo mount --bind /dev "${workdir}"/dev
    sudo mount -t devpts chpts "${AGENT_SDK_NFS_PATH}"/dev/pts

    LC_ALL=C LANGUAGE=C LANG=C sudo chroot "${AGENT_SDK_NFS_PATH}"
}
alias AgentMountRootfs="mount_rootfs"

function umount_rootfs()
{
    sudo umount -l --recursive "${AGENT_SDK_NFS_PATH}"/dev >/dev/null 2>&1
    sudo umount -l "${AGENT_SDK_NFS_PATH}"/proc >/dev/null 2>&1
    sudo umount -l "${AGENT_SDK_NFS_PATH}"/sys >/dev/null 2>&1

    sudo umount -l ${AGENT_SDK_NFS_PATH}
}
alias AgentUMountRootfs="umount_rootfs"

# Function:
# umount_chroot
#
# Description:
# umount kernel process in the chroot directory for exit
#
# Parameters:
# none
umount_chroot()
{
    while grep -Eq "${AGENT_SDK_NFS_PATH}.*(dev|proc|sys)" /proc/mounts
    do
        sudo umount -l --recursive "${AGENT_SDK_NFS_PATH}"/dev >/dev/null 2>&1
        sudo umount -l "${AGENT_SDK_NFS_PATH}"/proc >/dev/null 2>&1
        sudo umount -l "${AGENT_SDK_NFS_PATH}"/sys >/dev/null 2>&1
        sleep 5
    done
}

# Function:
# mount_chroot
#
# Description:
# mount kernel process in the chroot directory then can run
#
# Parameters:
# none
mount_chroot()
{
    sudo mount -t proc chproc "${AGENT_SDK_NFS_PATH}"/proc
    sudo mount -t sysfs chsys "${AGENT_SDK_NFS_PATH}"/sys
    sudo mount -t devtmpfs chdev "${AGENT_SDK_NFS_PATH}"/dev || sudo mount --bind /dev "${AGENT_SDK_NFS_PATH}"/dev
    sudo mount -t devpts chpts "${AGENT_SDK_NFS_PATH}"/dev/pts
}

function enter_chroot()
{
    cd "${AGENT_SDK_NFS_PATH}"/ || return

    mount_rootfs
    
    # exit the chroot
    umount_chroot

    #enter chroot
    mount_chroot

    if [ -f "${AGENT_SDK_NFS_PATH}"/bin/bash ]; then
        LC_ALL=C LANGUAGE=C LANG=C sudo chroot "${AGENT_SDK_NFS_PATH}" chown root:root /usr/bin/sudo
        LC_ALL=C LANGUAGE=C LANG=C sudo chroot "${AGENT_SDK_NFS_PATH}" chmod u+s /usr/bin/sudo
        LC_ALL=C LANGUAGE=C LANG=C sudo chroot "${AGENT_SDK_NFS_PATH}"
    else
        LC_ALL=C LANGUAGE=C LANG=C sudo chroot "${AGENT_SDK_NFS_PATH}" /bin/sh
    fi    
}
alias AgentEnterChroot="enter_chroot"

function exit_chroot()
{
    # exit the chroot
    umount_chroot

    umount_rootfs
}
alias AgentExitChroot="exit_chroot"