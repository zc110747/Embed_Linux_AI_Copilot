echo "Load the AI Copilot Env Data..."

export CPU_PROGRAM=NXP-IMX6ULL
export COMPILE_CPU_CORE=6
export AI_PROGRAM_PATH=/home/freedom/coding_git/Embed_LINUX_AI_Copilot

#-------------------------------------------------------------------------------
