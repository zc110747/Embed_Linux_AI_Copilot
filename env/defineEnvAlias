echo "Load the AI Copilot Env Data..."

export CPU_PROGRAM=NXP-IMX6ULL
export COMPILE_CPU_CORE=6

#-------------------------------------------------------------------------------
# This section defines the internal 
# Not need Change unless program change.
#-------------------------------------------------------------------------------
export AGENT_PLATFORM_PATH=${AGENT_SOURCE_PATH}/platform
export AGENT_PLATFORM_SOC_PATH=${AGENT_PLATFORM_PATH}/${CPU_PROGRAM}

export AGENT_SDK_PATH=${AGENT_SOURCE_PATH}/sdk
export AGENT_SDK_QEMU_PATH=${AGENT_SDK_PATH}/qemu
export AGENT_SDK_NFS_PATH=${AGENT_SDK_SOC_PATH}/nfs
export AGENT_SDK_SOC_PATH=${AGENT_SDK_PATH}/${CPU_PROGRAM}
export AGENT_SDK_KERNEL_PATH=${AGENT_SDK_SOC_PATH}/kernel

source ${AGENT_SOURCE_PATH}/env/defineAlias

export AGENT_IMG=buildroot.img


#-------------------------------------------------------------------------------
# This section defines global alias
#-------------------------------------------------------------------------------
alias aip="cd ${AGENT_SOURCE_PATH}"
alias aipp="cd ${AGENT_PLATFORM_SOC_PATH}"
alias aips="cd ${AGENT_SDK_SOC_PATH}"
alias aipq="cd ${AGENT_SDK_QEMU_PATH}"
alias aipn="cd ${AGENT_SDK_NFS_PATH}"
