{
  "name": "spi-diagnose",
  "version": "1.0",
  "params": {
    "bus": 0
  },
  "steps": [
    {
      "name": "device_list",
      "type": "exec",
      "input": "ls /dev/spi*"
    },
    {
      "name": "sysfs_devices",
      "type": "exec",
      "input": "ls /sys/bus/spi/devices/"
    },
    {
      "name": "sysfs_drivers",
      "type": "exec",
      "input": "ls /sys/bus/spi/drivers/"
    },
    {
      "name": "bus_info",
      "type": "exec",
      "input": "ls /sys/bus/spi/devices/spi{{bus}}* 2>/dev/null || echo 'no spi{{bus}} device found'"
    },
    {
      "name": "driver_log",
      "type": "exec",
      "input": "dmesg | grep -i spi"
    }
  ]
}
